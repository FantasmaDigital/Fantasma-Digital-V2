{
  "name": "fantasma-digital-v2",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Fantasma Digital",
  "scripts": {
    "install:client": "cd Client && pnpm install",
    "install:server": "cd Server && pnpm install",
    "install:all": "pnpm install && pnpm run install:client && pnpm run install:server",
    "dev:client": "cd Client && pnpm run dev",
    "dev:server": "cd Server && pnpm run dev",
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
